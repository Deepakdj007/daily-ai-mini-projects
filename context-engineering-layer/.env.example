# Free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides. The defaults are what the leaderboard was measured with.
# CHAT_MODEL=openai/gpt-oss-120b
# SWAP_MODEL=openai/gpt-oss-20b

# The assembled-context ceiling every layer works to. Must stay under
# TPM minus the completion reservation - see src/config.py for the arithmetic.
# CONTEXT_BUDGET_TOKENS=3000

# Completion budget. This is rate-limit arithmetic, not a style setting:
# Groq reserves prompt + completion against the per-minute ceiling before
# it runs anything.
# MAX_COMPLETION_TOKENS=256
