# Free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides. The defaults are what the leaderboard was measured with.
# CHAT_MODEL=openai/gpt-oss-120b
# GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# POLICY_MODEL=openai/gpt-oss-safeguard-20b

# A user turn at or above this score gets escalated to the policy judge.
# USER_ESCALATE_AT=0.5
# A retrieved document at or above this score is dropped outright.
# DOC_QUARANTINE_AT=0.8
# Presidio confidence floor for the output firewall.
# PII_MIN_SCORE=0.35
