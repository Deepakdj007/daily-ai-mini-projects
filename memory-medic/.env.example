# Free Groq API key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides. The defaults are what the leaderboard was measured with.
# CHAT_MODEL=openai/gpt-oss-120b
# Extraction runs on the small model on purpose: it is shared by every arm of
# the ablation, so a weaker extractor lowers all of them equally and cannot bias
# a comparison - and Groq's daily ceiling is per model, so this doubles the run.
# EXTRACT_MODEL=openai/gpt-oss-20b

# append | overwrite | scoped | bitemporal - how a new fact resolves against
# what is already stored. `overwrite` is the incumbent behaviour: delete on
# contradiction. `bitemporal` supersedes and keeps the old row.
# WRITE_POLICY=bitemporal

# 0 applies repairs the agent is unsure about instead of parking them for review.
# GATE_ENABLED=1
# SWEEP_ENABLED=1

# Freeze the agent's clock, e.g. 2026-12-01. Empty means the system clock.
# A year of decay is only demonstrable if the clock can be moved.
# CLOCK_AT=
# SWEEP_INTERVAL_S=30
