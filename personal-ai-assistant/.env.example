# Bot token from @BotFather on Telegram: https://t.me/BotFather (send /newbot)
TELEGRAM_BOT_TOKEN=

# Free Groq API key from https://console.groq.com/keys
GROQ_API_KEY=

# Your Telegram chat id. Leave empty on first run — message /start to the bot
# and it will tell you this value; paste it here and restart.
OWNER_CHAT_ID=
