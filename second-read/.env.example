# second-read runs entirely on a local Ollama server. There is no API key,
# no account, and no token budget anywhere in this project.
#
# Only set this if your Ollama server is not on the default 127.0.0.1:11434.
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional model overrides. Both default to the tags in src/config.py.
# SUBJECT_MODEL=medgemma1.5:4b
# TWIN_MODEL=gemma3:4b
