# Free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. The analysts fumble tool calls on very small models — raise this to
# gemini-3.5-flash if the briefings come back thin. Default: gemini-3.1-flash-lite
MODEL_ANALYST=

# Optional. The model that writes the final note. Default: gemini-3.1-flash-lite
MODEL_EDITOR=

# Optional. Requests per minute ceiling per agent. Four analysts fire at once, so
# it is the burst that trips free-tier limits. Default: 12
MAX_RPM=
